+			continue;
+
+		do {
+			start = max(start, vma->vm_start);
+			end = ALIGN(start + (pages << PAGE_SHIFT), HPAGE_SIZE);
+			end = min(end, vma->vm_end);
+			nr_pte_updates = change_prot_numa(vma, start, end, false, false, NULL);
+
+			/*
+			 * Try to scan sysctl_numa_balancing_size worth of
+			 * hpages that have at least one present PTE that
+			 * is not already pte-numa. If the VMA contains
+			 * areas that are unused or already full of prot_numa
+			 * PTEs, scan up to virtpages, to skip through those
+			 * areas faster.
+			 */
+			if (nr_pte_updates)
+				pages -= (end - start) >> PAGE_SHIFT;
+			virtpages -= (end - start) >> PAGE_SHIFT;
+
+			start = end;
+			if (pages <= 0 || virtpages <= 0)
+				goto out_twice;
+
+			cond_resched();
+		} while (end != vma->vm_end);
+	}
+
+out_twice:
+	/*
+	 * It is possible to reach the end of the VMA list but the last few
+	 * VMAs are not guaranteed to the vma_migratable. If they are not, we
+	 * would find the !migratable VMA on the next scan but not reset the
+	 * scanner to the start so check it now.
+	 */
+	if (vma)
+		mm->numa_scan_offset = start;
+	else
+		reset_ptenuma_scan(p);
+	mmap_read_unlock(mm);
+
+	/*
+	 * Make sure tasks use at least 32x as much time to run other code
+	 * than they used here, to limit NUMA PTE scanning overhead to 3% max.
+	 * Usually update_task_scan_period slows down scanning enough; on an
+	 * overloaded system we need to limit overhead on a per task basis.
+	 */
+	if (unlikely(pc->se.sum_exec_runtime != runtime)) {
+		u64 diff = pc->se.sum_exec_runtime - runtime;
+		p->node_stamp += 32 * diff;
+	}
+}
+
+if (sysctl_numa_balancing_mode & NUMA_BALANCING_MEMORY_TIERING){
+	unsigned long migrate, next_scan, now = jiffies;
+	struct task_struct *pc = current;
+	struct mm_struct *mm = p->mm;
+	u64 runtime = pc->se.sum_exec_runtime;
+	struct vm_area_struct *vma;
+	unsigned long start, end;
+	unsigned long nr_pte_updates = 0;
+	long pages, virtpages, orig_virtpages;
+	unsigned long sum_nr_pte_updates = 0;
+	struct vm_area_struct *tmp_vma;
+
+	/*
+	 * Who cares about NUMA placement when they're dying.
+	 *
+	 * NOTE: make sure not to dereference p->mm before this check,
+	 * exit_task_work() happens _after_ exit_mm() so we could be called
+	 * without p->mm even though we still had it when we enqueued this
+	 * work.
+	 */
+	if (p->flags & PF_EXITING)
+		return;
+
+	if (!mm->numa_next_scan) {
+		mm->numa_next_scan = now +
+			msecs_to_jiffies(sysctl_numa_balancing_scan_delay);
+	}
+
+	/*
+	 * Enforce maximal scan/migration frequency..
+	 */
+	migrate = mm->numa_next_scan;
+	if (time_before(now, migrate))
+		return;
+
+	if (p->numa_scan_period == 0) {
+		p->numa_scan_period_max = task_scan_max(p);
+		p->numa_scan_period = task_scan_start(p);
+	}
+
+	next_scan = now + msecs_to_jiffies(p->numa_scan_period);
+	if (cmpxchg(&mm->numa_next_scan, migrate, next_scan) != migrate)
+		return;
+
+	/*
+	 * Delay this task enough that another task of this mm will likely win
+	 * the next time around.
+	 */
+	p->node_stamp += 2 * TICK_NSEC;
+
+	start = mm->numa_scan_offset;
+	pages = sysctl_numa_balancing_scan_size;
+	pages <<= 20 - PAGE_SHIFT; /* MB in pages */
+	virtpages = pages * 8;	   /* Scan up to this much virtual space */
+	if (!pages)
+		return;
+
+
+	if (!mmap_read_trylock(mm))
+		return;
+	
+	// before loop on vma, scan the  hotpage candidates
+	int candi_cnt = 0;
+	int candi_cnt1 = 0;
+	void* i_entry;
+	unsigned long candi_index = 0;
+	xa_for_each (mm->hotpage_cadi, candi_index, i_entry){
+		unsigned long page_num = xa_to_value(i_entry);
+		candi_cnt1 += 1;
+		if (page_num >= ((unsigned long)1 << 36)) continue;
+		unsigned long page_addr = page_num << 12;
+		vma = find_vma(mm, page_addr);
+		if (!vma) continue;
+		if (!vma_migratable(vma) || !vma_policy_mof(vma) ||
+			is_vm_hugetlb_page(vma) || (vma->vm_flags & VM_MIXEDMAP)) {
+			continue;
+		}
+		if (!vma->vm_mm ||
+		    (vma->vm_file && (vma->vm_flags & (VM_READ|VM_WRITE)) == (VM_READ)))
+			continue;
+		if (!vma_is_accessible(vma))
+			continue;
+		nr_pte_updates = change_prot_numa(vma, page_addr, page_addr + (1 << 12), false, false, NULL);
+		if (nr_pte_updates) {
+			pages -= 1;
+			candi_cnt += 1;
+		}
+		virtpages -= 1;
+	}
+
+	tmp_vma = find_vma(mm, 0);
+	unsigned long tmp_start = 0;
+	if (tmp_vma) 
+		tmp_start = tmp_vma->vm_start;
+	else {
+		printk(KERN_WARNING "Tiering(WARN): Proc %d now has ZERO vm area.\n", p->pid);
+		reset_ptenuma_scan(p);
+		// start = 0;
+		vma = mm->mmap;
+		goto out_whatplus;
+	}
+	
+	// log newly added vma(if exist) into scanlog and scanxa
+	for (; tmp_vma; tmp_vma = tmp_vma->vm_next) {
+		unsigned long index_start_p = tmp_vma->vm_start;
+		unsigned long index_end_p;
+		while (index_start_p < tmp_vma->vm_end){
+			index_end_p = ((index_start_p >> 28) + 1) << 28;
+			index_end_p = min(index_end_p, tmp_vma->vm_end);
+			unsigned long indexto = index_start_p >> 28;
+			void *curxa_entry = xa_find(mm->scan_results_xa, &indexto, (1 << 21), XA_MARK_1);
+			if (indexto == (index_start_p >> 28) && curxa_entry){
+				unsigned long logidx = xa_to_value(curxa_entry);
+				mm->scan_results_log[logidx * 8 + 1] = index_end_p - index_start_p;
+			}
+			else {
+				unsigned long logidx = mm->log_head_n;
+				WRITE_ONCE(mm->log_head_n, READ_ONCE(mm->log_head_n) + 1);
+				if (mm->log_head_n >= mm->log_size_n){
+					int new_log_size = mm->log_size_n * 2;
+					void *new_log_buf = krealloc(mm->scan_results_log, sizeof(unsigned long) * new_log_size * 8, GFP_ATOMIC);
+					if (!new_log_buf){ 
+						printk(KERN_WARNING "Tiering(ERR): The scanlog resize failed.\n");
+						goto out_whatplus;
+					}
+					mm->scan_results_log = (unsigned long*)new_log_buf;
+					/* To set new part of the logs */
+					int i;
+					for (i = mm->log_size_n * 8; i < new_log_size * 8; i = i + 8) {
+						mm->scan_results_log[i] = (((unsigned long)1) << 48) - 1;
+						mm->scan_results_log[i + 1] = (unsigned long)0;
+						mm->scan_results_log[i + 2] = (unsigned long)0;
+						mm->scan_results_log[i + 3] = (unsigned long)0;
+						mm->scan_results_log[i + 4] = (unsigned long)0;
+						mm->scan_results_log[i + 5] = (unsigned long)0;
+						mm->scan_results_log[i + 6] = (unsigned long)0;
+						mm->scan_results_log[i + 7] = (unsigned long)0;
+					}
+					mm->log_size_n = new_log_size;
+				}
+				WRITE_ONCE(mm->scan_results_log[logidx * 8], index_start_p >> 28);
+				WRITE_ONCE(mm->scan_results_log[logidx * 8 + 1], index_end_p - index_start_p);
+				curxa_entry = xa_mk_value(logidx);
+				void *tmpstoreres = xa_store(mm->scan_results_xa, (index_start_p >> 28), curxa_entry, GFP_ATOMIC);
+				if (xa_err(tmpstoreres) < 0){
+					printk(KERN_WARNING "Tiering(ERR): xa_store failed(%d) for addr %lx.\n", 
+						0 - xa_err(tmpstoreres), index_start_p);
+				}
+				else{
+					xa_set_mark(mm->scan_results_xa, (index_start_p >> 28), XA_MARK_1);
+				}
+			}
+			index_start_p = index_end_p;
+		}
+	}
+
+	unsigned long scan_epoch_prep = (mm->total_vm) / (unsigned long)pages;
+	scan_epoch_prep = scan_epoch_prep + 2;
+	unsigned long scan_epoch_round = scan_epoch_prep * 3;
+
+	// For test, we can set scan_epoch_prep=scan_epoch_round
+	scan_epoch_prep = scan_epoch_round;
+
+	unsigned long scan_epoch_curr = READ_ONCE(mm->scan_epoch);
+	scan_epoch_curr = scan_epoch_curr % scan_epoch_round;
+
+	int log_idx;
+	unsigned long scan_UNIT = (unsigned long)1 << 21;
+
+	if (scan_epoch_curr < scan_epoch_prep){
+		// should evenly scan all segments in prep epochs
+		int cons_log_head = READ_ONCE(mm->log_head_n);
+		if (scan_epoch_curr == 0){
+			// for (log_idx = 0; log_idx < cons_log_head; ++log_idx){
+			// 	WRITE_ONCE(mm->scan_results_log[log_idx * 8 + 4], (unsigned long)0);
+			// }
+			printk(KERN_WARNING "Tiering(101): Proc %d entered scan mode 1.\n", p->pid);
+			mm->numa_scan_offset = 0;
+		}
+
+		do {
+			start = READ_ONCE(mm->scan_results_log[mm->numa_scan_offset * 8 + 4]);
+			start = start + ((mm->scan_results_log[mm->numa_scan_offset * 8]) << 28);
+			tmp_vma = find_vma(mm, start); 
+			int skip_vma_flag = 0;
+			if (!tmp_vma) skip_vma_flag = 1;
+			else{
+				if (!vma_migratable(tmp_vma) || !vma_policy_mof(tmp_vma) ||
+					is_vm_hugetlb_page(tmp_vma) || (tmp_vma->vm_flags & VM_MIXEDMAP)) skip_vma_flag = 1;
+				if (!tmp_vma->vm_mm ||
+					(tmp_vma->vm_file && (tmp_vma->vm_flags & (VM_READ|VM_WRITE)) == (VM_READ))) skip_vma_flag = 1;
+				if (!vma_is_accessible(tmp_vma)) skip_vma_flag = 1;
+			}
+			if (skip_vma_flag){
+
+				WRITE_ONCE(mm->scan_results_log[mm->numa_scan_offset * 8 + 5], (scan_UNIT << 3));
+				unsigned long collected_hotness = READ_ONCE(mm->scan_results_log[mm->numa_scan_offset * 8 + 3]);
+				WRITE_ONCE(mm->scan_results_log[mm->numa_scan_offset * 8 + 6], collected_hotness);
+
+				end = READ_ONCE(mm->scan_results_log[mm->numa_scan_offset * 8 + 4]);
+				// end = end + (scan_UNIT << 3);
+				end = end + mm->scan_results_log[mm->numa_scan_offset * 8 + 5];
+				if (end >= (1 << 28)) end = 0;
+				WRITE_ONCE(mm->scan_results_log[mm->numa_scan_offset * 8 + 4], end);
+				virtpages -= (mm->scan_results_log[mm->numa_scan_offset * 8 + 5]) >> PAGE_SHIFT;
+				WRITE_ONCE(mm->numa_scan_offset, (mm->numa_scan_offset + 1) % cons_log_head);
+				continue;
+			}
+
+			WRITE_ONCE(mm->scan_results_log[mm->numa_scan_offset * 8 + 5], (scan_UNIT << 3));
+			unsigned long collected_hotness = READ_ONCE(mm->scan_results_log[mm->numa_scan_offset * 8 + 3]);
+			WRITE_ONCE(mm->scan_results_log[mm->numa_scan_offset * 8 + 6], collected_hotness);
+
+			start = max(start, tmp_vma->vm_start);
+			end = start + mm->scan_results_log[mm->numa_scan_offset * 8 + 5];
+			end = ALIGN(end, scan_UNIT);
+			// end = start + (scan_UNIT << 3);
+			end = min(end, tmp_vma->vm_end);
+			nr_pte_updates = change_prot_numa(tmp_vma, start, end, false, false, NULL);
+			if (nr_pte_updates)
+				pages -= (end - start) >> PAGE_SHIFT;
+			virtpages -= (end - start) >> PAGE_SHIFT;
+
+			sum_nr_pte_updates += nr_pte_updates;
+
+			end = end - ((mm->scan_results_log[mm->numa_scan_offset * 8]) << 28);
+			if (end >= (1 << 28)) end = 0;
+			WRITE_ONCE(mm->scan_results_log[mm->numa_scan_offset * 8 + 4], end);
+			WRITE_ONCE(mm->numa_scan_offset, (mm->numa_scan_offset + 1) % cons_log_head);
+			cond_resched();
+		}
+		while (pages > 0 && virtpages > 0);
+	}
+	else{
+		// should scan every segments with its scan_step
+		int cons_log_head = READ_ONCE(mm->log_head_n);
+		if (scan_epoch_curr == scan_epoch_prep){
+			printk(KERN_WARNING "Tiering(102): Proc %d entered scan mode 2.\n", p->pid);
+			// for (log_idx = 0; log_idx < cons_log_head; ++log_idx){
+			// 	WRITE_ONCE(mm->scan_results_log[log_idx * 8 + 4], (unsigned long)0);
+			// }
+			mm->numa_scan_offset = 0;
+		}
+
+		long hotcounter3sum = 0;
+		long local_hotness = 0;
+		for (log_idx = 0; log_idx < cons_log_head; ++log_idx){
+			local_hotness = mm->scan_results_log[log_idx * 8 + 3] - mm->scan_results_log[log_idx * 8 + 6];
+			hotcounter3sum += local_hotness;
+		}
+		hotcounter3sum = hotcounter3sum / cons_log_head;
+
+		do {
+			start = READ_ONCE(mm->scan_results_log[mm->numa_scan_offset * 8 + 4]);
+			start = start + ((mm->scan_results_log[mm->numa_scan_offset * 8]) << 28);
+			tmp_vma = find_vma(mm, start); 
+			int skip_vma_flag = 0;
+			if (!tmp_vma) skip_vma_flag = 1;
+			else{
+				if (!vma_migratable(tmp_vma) || !vma_policy_mof(tmp_vma) ||
+					is_vm_hugetlb_page(tmp_vma) || (tmp_vma->vm_flags & VM_MIXEDMAP)) skip_vma_flag = 1;
+				if (!tmp_vma->vm_mm ||
+					(tmp_vma->vm_file && (tmp_vma->vm_flags & (VM_READ|VM_WRITE)) == (VM_READ))) skip_vma_flag = 1;
+				if (!vma_is_accessible(tmp_vma)) skip_vma_flag = 1;
+			}
+			if (skip_vma_flag){
+
+				WRITE_ONCE(mm->scan_results_log[mm->numa_scan_offset * 8 + 5], (scan_UNIT << 3));
+				unsigned long collected_hotness = READ_ONCE(mm->scan_results_log[mm->numa_scan_offset * 8 + 3]);
+				WRITE_ONCE(mm->scan_results_log[mm->numa_scan_offset * 8 + 6], collected_hotness);
+
+				end = READ_ONCE(mm->scan_results_log[mm->numa_scan_offset * 8 + 4]);
+				// end = end + (scan_UNIT << 3);
+				end = end + mm->scan_results_log[mm->numa_scan_offset * 8 + 5];
+				if (end >= (1 << 28)) end = 0;
+				WRITE_ONCE(mm->scan_results_log[mm->numa_scan_offset * 8 + 4], end);
+				virtpages -= (mm->scan_results_log[mm->numa_scan_offset * 8 + 5]) >> PAGE_SHIFT;
+				WRITE_ONCE(mm->numa_scan_offset, (mm->numa_scan_offset + 1) % cons_log_head);
+				continue;
+			}
+
+			local_hotness = mm->scan_results_log[mm->numa_scan_offset * 8 + 3] - mm->scan_results_log[mm->numa_scan_offset * 8 + 6];
+			int scale_step = 2;
+			while (local_hotness >= hotcounter3sum){
+				local_hotness = local_hotness >> 1;
+				scale_step += 1;
+				if (scale_step > 6) break;
+			}
+			WRITE_ONCE(mm->scan_results_log[mm->numa_scan_offset * 8 + 5], (scan_UNIT << scale_step));
+			unsigned long collected_hotness = READ_ONCE(mm->scan_results_log[mm->numa_scan_offset * 8 + 3]);
+			WRITE_ONCE(mm->scan_results_log[mm->numa_scan_offset * 8 + 6], collected_hotness);
+
+			start = max(start, tmp_vma->vm_start);
+			end = start + mm->scan_results_log[mm->numa_scan_offset * 8 + 5];
+			end = ALIGN(end, scan_UNIT);
+			// end = start + (scan_UNIT << 3);
+			end = min(end, tmp_vma->vm_end);
+			nr_pte_updates = change_prot_numa(tmp_vma, start, end, false, false, NULL);
+			if (nr_pte_updates)
+				pages -= (end - start) >> PAGE_SHIFT;
+			virtpages -= (end - start) >> PAGE_SHIFT;
+
+			sum_nr_pte_updates += nr_pte_updates;
+
+			end = end - ((mm->scan_results_log[mm->numa_scan_offset * 8]) << 28);
+			if (end >= (1 << 28)) end = 0;
+			WRITE_ONCE(mm->scan_results_log[mm->numa_scan_offset * 8 + 4], end);
+			WRITE_ONCE(mm->numa_scan_offset, (mm->numa_scan_offset + 1) % cons_log_head);
+			cond_resched();
+		}
+		while (pages > 0 && virtpages > 0);
+	}
+
+out_whatplus:
+	WRITE_ONCE(mm->scan_epoch, READ_ONCE(mm->scan_epoch) + 1);
+	mmap_read_unlock(mm);
+
+	/*
+	 * Make sure tasks use at least 32x as much time to run other code
+	 * than they used here, to limit NUMA PTE scanning overhead to 3% max.
+	 * Usually update_task_scan_period slows down scanning enough; on an
+	 * overloaded system we need to limit overhead on a per task basis.
+	 */
+	if (unlikely(pc->se.sum_exec_runtime != runtime)) {
+		u64 diff = pc->se.sum_exec_runtime - runtime;
+		p->node_stamp += 32 * diff;
+	}
+}
+else{
+	unsigned long migrate, next_scan, now = jiffies;
+	struct task_struct *pc = current;
+	struct mm_struct *mm = p->mm;
+	u64 runtime = pc->se.sum_exec_runtime;
+	struct vm_area_struct *vma;
+	unsigned long start, end;
+	unsigned long nr_pte_updates = 0;
+	long pages, virtpages;
 
-	work->next = work;
 	/*
 	 * Who cares about NUMA placement when they're dying.
 	 *
@@ -2805,7 +3972,7 @@
 			start = max(start, vma->vm_start);
 			end = ALIGN(start + (pages << PAGE_SHIFT), HPAGE_SIZE);
 			end = min(end, vma->vm_end);
-			nr_pte_updates = change_prot_numa(vma, start, end);
+			nr_pte_updates = change_prot_numa(vma, start, end, false, false, NULL);
 
 			/*
 			 * Try to scan sysctl_numa_balancing_size worth of
@@ -2846,12 +4013,385 @@
 	 * Usually update_task_scan_period slows down scanning enough; on an
 	 * overloaded system we need to limit overhead on a per task basis.
 	 */

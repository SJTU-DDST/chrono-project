-		u64 diff = p->se.sum_exec_runtime - runtime;
+	if (unlikely(pc->se.sum_exec_runtime != runtime)) {
+		u64 diff = pc->se.sum_exec_runtime - runtime;
+		p->node_stamp += 32 * diff;
+	}
+}
+
+}
+
+static inline void calculate_promote_info(struct sample_block *sample_info, struct promote_info_t *res)
+{
+	unsigned int start_ptr = 0, end_ptr = 20; // should use the same const variable as in sample_block
+	unsigned long start_cnt, end_cnt, total_cnt = 0;
+	unsigned long start_threshold, end_threshold;
+	
+	start_cnt = sample_info->nr_hit_percent[1][start_ptr];
+	end_cnt = sample_info->nr_hit_percent[0][end_ptr];
+
+	while (start_ptr <= end_ptr) {
+		if(start_cnt <= end_cnt){
+			total_cnt += start_cnt;
+			end_cnt -= start_cnt;
+			start_cnt = 0;
+			start_ptr++;
+			if(start_ptr > 20)
+				break;
+			else
+				start_cnt = sample_info->nr_hit_percent[1][start_ptr];
+		}else{
+			total_cnt += end_cnt;
+			start_cnt -= end_cnt;
+			end_cnt = 0;
+			end_ptr--;
+			if(end_ptr <= 0)
+				break;
+			else
+				end_cnt = sample_info->nr_hit_percent[0][end_ptr];
+		}
+	}
+	if(start_ptr > 20)
+		start_threshold = (20 + 1) * 100;
+	else
+		start_threshold = start_ptr * 100 + start_cnt * 100 / (sample_info->nr_hit_percent[1][start_ptr] + 1);
+	
+	if(end_ptr < 0)
+		end_threshold = 0;
+	else
+		end_threshold = (end_ptr + 1) * 100 - end_cnt * 100 / (sample_info->nr_hit_percent[0][end_ptr] + 1);
+
+	res->threshold = (start_threshold + end_threshold) / 2;
+	res->rate = total_cnt << sysctl_numa_balancing_statistic_prop;
+	res->rate = (res->rate<<PAGE_SHIFT) >> 20;
+
+}
+
+static inline void numa_statistic_aggregate(struct task_struct *p)
+{
+	int tier_cnt,phase_cnt;
+	struct sample_block *now_block;
+	struct list_head *info_head;
+	struct pglist_data *top_pgdat;
+	int info_cnt = 0, is_update = 0;
+	struct promote_info_t *evict_entry,* now_entry;
+	unsigned long prev_threshold, prev_rate;
+	now_block = p->mm->numa_sample_block_prev;
+	p->in_sample_block_init = 1;
+	memcpy(p->mm->numa_sample_block_prev, p->mm->numa_sample_block, sizeof(struct sample_block));	// snapshot
+	memset(p->mm->numa_sample_block, 0, sizeof(struct sample_block));
+	
+	for(tier_cnt=0;tier_cnt<2;tier_cnt++){
+		if(now_block->nr_hit[tier_cnt] > now_block->nr_sample[tier_cnt]) now_block->nr_sample[tier_cnt] = now_block->nr_hit[tier_cnt];
+		printk(KERN_WARNING" (pid %d): hit %lu/%lu pages for tier %d", p->pid, now_block->nr_hit[tier_cnt], now_block->nr_sample[tier_cnt], tier_cnt);
+		if(now_block->nr_hit[tier_cnt] == 0) continue;
+
+		now_block->avg_time[tier_cnt] /= now_block->nr_hit[tier_cnt];
+		now_block->avg_time[tier_cnt] -= now_block->begin_time;
+	}
+	if(now_block->nr_hit[0] + now_block->nr_hit[1] > 1000){	// should use more reasonable method
+		now_entry = p->present_premote_info;
+		prev_threshold = now_entry->threshold;
+		prev_rate = now_entry->rate;
+		calculate_promote_info(now_block, now_entry);
+
+		top_pgdat = NODE_DATA(0);
+		if(top_pgdat == NULL)
+			goto out;
+		spin_lock(&top_pgdat->numa_lock);
+		info_head = &top_pgdat->active_statistic_list;
+		if(now_entry->list.next != LIST_POISON1 && now_entry->list.prev != LIST_POISON2){
+			top_pgdat->promote_info.threshold -= prev_threshold;
+			top_pgdat->promote_info.rate -= prev_rate;
+			list_del(&now_entry->list);
+			top_pgdat->statistic_list_size--;
+		}else if(top_pgdat->statistic_list_size >= 64){
+			evict_entry = list_entry(info_head->prev, struct promote_info_t, list);
+			if(unlikely(evict_entry == now_entry)){
+				top_pgdat->promote_info.threshold -= prev_threshold;
+				top_pgdat->promote_info.rate -= prev_rate;
+			}else{
+				top_pgdat->promote_info.threshold -= evict_entry->threshold;
+				top_pgdat->promote_info.rate -= evict_entry->rate;
+			}
+			list_del(info_head->prev);
+			top_pgdat->statistic_list_size--;
+		}
+		top_pgdat->statistic_list_size++;
+		list_add(&now_entry->list, info_head);
+		top_pgdat->promote_info.threshold += now_entry->threshold;
+		top_pgdat->promote_info.rate += now_entry->rate;
+		/*
+		printk(KERN_WARNING" (pid %d): total: {%lu,%lu} in size %lu, local: {%lu,%lu}", p->pid, top_pgdat->promote_info.threshold/top_pgdat->statistic_list_size,
+								top_pgdat->promote_info.rate/top_pgdat->statistic_list_size, top_pgdat->statistic_list_size, now_entry->threshold, now_entry->rate);
+		*/
+		spin_unlock(&top_pgdat->numa_lock);	
+	}
+out:
+	p->in_sample_block_init = 0;
+}
+
+static inline void init_statistic_records(struct task_struct *p)
+{
+	struct rb_root *root;
+	unsigned long max_latency = jiffies - p->mm->numa_sample_block->begin_time;
+	swap(p->mm->prev_rb_root, p->mm->now_rb_root);
+	root = &p->mm->now_rb_root;
+	if(root == NULL) return;
+	clear_records(p, max_latency);
+}
+
+static noinline void reset_scan(struct task_struct *p){
+	struct mm_struct *mm = p->mm;
+	struct vm_area_struct *vma;
+	unsigned long start, end;
+	unsigned long nr_pages_updates = 0, nr_fast = 0;
+	struct rb_node *node = rb_first(&mm->prev_rb_root), *nxt_node;
+	struct numa_sample_record *now_record, *next_record;
+	if (!mmap_read_trylock(mm))
+		return;
+
+	vma = find_vma(mm, 0);
+	if (!vma)
+		vma = mm->mmap;
+	for (; vma; vma = vma->vm_next) {
+		if (!vma_migratable(vma) || !vma_policy_mof(vma) ||
+			is_vm_hugetlb_page(vma) || (vma->vm_flags & VM_MIXEDMAP)) {
+			continue;
+		}
+
+		/*
+		 * Shared library pages mapped by multiple processes are not
+		 * migrated as it is expected they are cache replicated. Avoid
+		 * hinting faults in read-only file-backed mappings or the vdso
+		 * as migrating the pages will be of marginal benefit.
+		 */
+		if (!vma->vm_mm ||
+		    (vma->vm_file && (vma->vm_flags & (VM_READ|VM_WRITE)) == (VM_READ)))
+			continue;
+
+		/*
+		 * Skip inaccessible VMAs to avoid any confusion between
+		 * PROT_NONE and NUMA hinting ptes
+		 */
+		if (!vma_is_accessible(vma))
+			continue;
+
+		for(;node;node = rb_next(node)){
+			now_record = rb_entry(node, struct numa_sample_record, node);
+			start = now_record->addr;
+			if(start < vma->vm_start || start >= vma->vm_end) break;
+			end = start + PAGE_SIZE;
+			while((nxt_node = rb_next(node)) != NULL){
+				next_record = rb_entry(nxt_node, struct numa_sample_record, node);
+				if(next_record->addr != end || next_record->addr >= vma->vm_end) break;
+				node = nxt_node;
+				end += PAGE_SIZE;
+			}
+			change_prot_numa(vma, start, end, true, true, &nr_fast);
+			cond_resched();
+		}
+		if(node == NULL) break;
+	}
+	mmap_read_unlock(mm);
+}
+
+static noinline void numa_statistic_scan(struct task_struct *p)
+{
+	unsigned long sample_migrate, next_sample, now = jiffies;
+	struct task_struct *pc = current;
+	struct mm_struct *mm = p->mm;
+	u64 runtime = pc->se.sum_exec_runtime;
+	struct vm_area_struct *vma;
+	unsigned long start, end;
+	unsigned long nr_pages_updates = 0, nr_fast = 0;
+	long pages, batch_pages, mask_bits = sysctl_numa_balancing_statistic_prop, random_bits, random_mask,counts = 0;
+	int sample_flag = sysctl_numa_balancing_statistic_enable;
+	unsigned long count_total = 0, bucket, now_addr, next_addr;
+
+	/*
+	 * Who cares about NUMA placement when they're dying.
+	 *
+	 * NOTE: make sure not to dereference p->mm before this check,
+	 * exit_task_work() happens _after_ exit_mm() so we could be called
+	 * without p->mm even though we still had it when we enqueued this
+	 * work.
+	 */
+	if (p->flags & PF_EXITING)
+		return;
+
+	if(!sample_flag)
+		return;
+
+	if(mm->numa_sample_block == NULL || mm->numa_sample_block_prev == NULL)
+		return;
+
+	if (!mm->numa_next_sample) {
+		mm->numa_next_sample = now + 
+			msecs_to_jiffies(sysctl_numa_balancing_statistic_sample_period);
+	}
+	/*
+	 * Enforce maximal sample frequency..
+	 */
+	sample_migrate = mm->numa_next_sample;
+	if (time_before(now, sample_migrate)){
+		//printk(KERN_WARNING" (pid %d), before migrate fail %u vs %u", p->pid, jiffies_to_msecs(now), jiffies_to_msecs(sample_migrate));
+		sample_flag = 0;
+	}
+
+	if (p->numa_sample_period == 0) {
+		// calculate based on total_memory, private and shared memory.
+		p->numa_sample_period_max = task_scan_max(p);
+		p->numa_sample_period = task_scan_start(p);
+	}
+
+	next_sample = now + msecs_to_jiffies(p->numa_sample_period);
+	if (sample_flag && cmpxchg(&mm->numa_next_sample, sample_migrate, next_sample) != sample_migrate){
+		sample_flag = 0;
+	}
+	if(!sample_flag) return;
+	else{
+		WRITE_ONCE(mm->sample_long_lock,1);
+		write_lock(&mm->sample_records_lock);
+		init_statistic_records(p);
+		write_unlock(&mm->sample_records_lock);
+		WRITE_ONCE(mm->sample_long_lock,0);
+		reset_scan(p);
+		numa_statistic_aggregate(p);
+	}
+	/*
+	 * Delay this task enough that another task of this mm will likely win
+	 * the next time around.
+	 */
+	p->node_stamp += 2 * TICK_NSEC;
+
+	start = 0;
+	batch_pages = 1 << sysctl_numa_balancing_statistic_batch;
+	batch_pages >>= PAGE_SHIFT;
+
+	if (!mmap_read_trylock(mm))
+		return;
+
+	vma = find_vma(mm, start);
+	if (!vma)
+		vma = mm->mmap;
+
+	random_mask = (1 << mask_bits)-1;
+	random_bits = prandom_u32_max(random_mask);
+	if(random_bits == p->mm->last_random_bits){
+		random_bits = (random_bits + 1) & random_mask;
+	}
+	p->mm->last_random_bits = random_bits;
+
+	p->mm->numa_sample_block->begin_time = jiffies;
+	for (; vma; vma = vma->vm_next) {
+		if (!vma_migratable(vma) || !vma_policy_mof(vma) ||
+			is_vm_hugetlb_page(vma) || (vma->vm_flags & VM_MIXEDMAP)) {
+			continue;
+		}
+
+		/*
+		 * Shared library pages mapped by multiple processes are not
+		 * migrated as it is expected they are cache replicated. Avoid
+		 * hinting faults in read-only file-backed mappings or the vdso
+		 * as migrating the pages will be of marginal benefit.
+		 */
+		if (!vma->vm_mm ||
+		    (vma->vm_file && (vma->vm_flags & (VM_READ|VM_WRITE)) == (VM_READ)))
+			continue;
+
+		/*
+		 * Skip inaccessible VMAs to avoid any confusion between
+		 * PROT_NONE and NUMA hinting ptes
+		 */
+		if (!vma_is_accessible(vma))
+			continue;
+		
+		do {
+			start = max(start, vma->vm_start);
+			end = ALIGN(start + (batch_pages << PAGE_SHIFT), HPAGE_SIZE);
+			end = min(end, vma->vm_end);
+			if(hash_64(start,mask_bits) == random_bits){
+				nr_pages_updates = change_prot_numa(vma, start, end, true, false, &nr_fast);
+				p->mm->numa_sample_block->nr_sample[0] += nr_fast;
+				p->mm->numa_sample_block->nr_sample[1] += nr_pages_updates;
+				counts++;
+			}
+			start = end;
+			cond_resched();
+		} while (end != vma->vm_end);
+	}
+	printk(KERN_WARNING" (pid %d): sample total (%lu,%lu)/%ld pages, random bits %ld", p->pid, p->mm->numa_sample_block->nr_sample[0], p->mm->numa_sample_block->nr_sample[1], counts, random_bits);
+	mmap_read_unlock(mm);
+	/*
+	 * Make sure tasks use at least 32x as much time to run other code
+	 * than they used here, to limit NUMA PTE scanning overhead to 3% max.
+	 * Usually update_task_scan_period slows down scanning enough; on an
+	 * overloaded system we need to limit overhead on a per task basis.
+	 */
+	if (unlikely(pc->se.sum_exec_runtime != runtime)) {
+		u64 diff = pc->se.sum_exec_runtime - runtime;
 		p->node_stamp += 32 * diff;
 	}
 }
 
+static int numa_balancing_init(void)
+{
+	numa_balancing_scan_wq = alloc_workqueue("numa_balancing_scan",
+		WQ_UNBOUND | WQ_FREEZABLE | WQ_SYSFS, 0);
+	if (!numa_balancing_scan_wq)
+		return -ENOMEM;
+
+	numa_balancing_promote_wq = alloc_workqueue("numa_balancing_promote",
+		WQ_UNBOUND | WQ_FREEZABLE | WQ_SYSFS, 0);
+	if (!numa_balancing_promote_wq)
+		return -ENOMEM;
+
+	return 0;
+}
+late_initcall(numa_balancing_init);
+
+/*
+ * The expensive part of numa migration is done from task_work context.
+ * Triggered from task_tick_numa().
+ */
+static noinline void task_numa_work(struct callback_head *work)
+{
+	struct task_struct *p = current;
+
+	SCHED_WARN_ON(p != container_of(work, struct task_struct, numa_work));
+
+	work->next = work;
+
+	if (sysctl_numa_balancing_scan_async && numa_balancing_scan_wq) {
+		queue_work_node(numa_node_id(), numa_balancing_scan_wq,
+				&p->numa_async_work);
+		return;
+	}
+
+	numa_scan(p);
+}
+
+static noinline void task_numa_statistic_work(struct callback_head *work)
+{
+	struct task_struct *p = current;
+
+	SCHED_WARN_ON(p != container_of(work, struct task_struct, numa_statistic_work));
+
+	work->next = work;
+
+	numa_statistic_scan(p);
+}
+
+static void numa_async_work(struct work_struct *work)
+{
+	struct task_struct *p;
+
+	p = container_of(work, struct task_struct, numa_async_work);
+
+	numa_scan(p);
+}
+
 void init_numa_balancing(unsigned long clone_flags, struct task_struct *p)
 {
 	int mm_users = 0;
@@ -2862,19 +4402,38 @@
 		if (mm_users == 1) {
 			mm->numa_next_scan = jiffies + msecs_to_jiffies(sysctl_numa_balancing_scan_delay);
 			mm->numa_scan_seq = 0;
+			mm->numa_next_sample = jiffies + msecs_to_jiffies(sysctl_numa_balancing_statistic_sample_period);
+			mm->sample_records_lock = __RW_LOCK_UNLOCKED(sample_records_lock);
+			mm->sample_long_lock = 0;
+			mm->now_rb_root = RB_ROOT;
+			mm->prev_rb_root = RB_ROOT;
+			mm->last_random_bits = ~0UL;
+			mm->numa_sample_block 		= kzalloc(sizeof(struct sample_block), GFP_KERNEL);
+			mm->numa_sample_block_prev 	= kzalloc(sizeof(struct sample_block), GFP_KERNEL);
 		}
 	}
+
 	p->node_stamp			= 0;
 	p->numa_scan_seq		= mm ? mm->numa_scan_seq : 0;
 	p->numa_scan_period		= sysctl_numa_balancing_scan_delay;
 	/* Protect against double add, see task_tick_numa and task_numa_work */
 	p->numa_work.next		= &p->numa_work;
+	p->numa_statistic_work.next	= &p->numa_statistic_work;
 	p->numa_faults			= NULL;
 	RCU_INIT_POINTER(p->numa_group, NULL);
 	p->last_task_numa_placement	= 0;
 	p->last_sum_exec_runtime	= 0;
 
+	p->present_premote_info		 = kzalloc(sizeof(struct promote_info_t), GFP_KERNEL);
+	p->present_premote_info->pid = p->pid;
+	p->present_premote_info->list.next = LIST_POISON1;
+	p->present_premote_info->list.prev = LIST_POISON2;
+
+	p->numa_sample_period		= sysctl_numa_balancing_statistic_period;
+	p->in_sample_block_init		= 0;
 	init_task_work(&p->numa_work, task_numa_work);
+	init_task_work(&p->numa_statistic_work, task_numa_statistic_work);
+	INIT_WORK(&p->numa_async_work, numa_async_work);
 
 	/* New address space, reset the preferred nid */
 	if (!(clone_flags & CLONE_VM)) {
@@ -2899,10 +4458,10 @@
 /*
  * Drive the periodic memory faults..
  */
-static void task_tick_numa(struct rq *rq, struct task_struct *curr)
+static void task_tick_numa(struct rq *rq, struct task_struct *curr)	// HYF mark temp
 {
 	struct callback_head *work = &curr->numa_work;
-	u64 period, now;
+	u64 period, now, node_stamp;
 
 	/*
 	 * We don't care about NUMA placement if we don't have memory.
@@ -2918,14 +4477,20 @@
 	 */
 	now = curr->se.sum_exec_runtime;
 	period = (u64)curr->numa_scan_period * NSEC_PER_MSEC;
-
-	if (now > curr->node_stamp + period) {
-		if (!curr->node_stamp)
+	node_stamp = curr->node_stamp;
+	
+	if (now > node_stamp + period) {
+		if (!node_stamp)
 			curr->numa_scan_period = task_scan_start(curr);
 		curr->node_stamp += period;
 
-		if (!time_before(jiffies, curr->mm->numa_next_scan))
+		if (!time_before(jiffies, curr->mm->numa_next_scan)){
 			task_work_add(curr, work, TWA_RESUME);
+			if(sysctl_numa_balancing_statistic_enable){
+				work = &curr->numa_statistic_work;
+				task_work_add(curr, work, TWA_RESUME);
+			}
+		}
 	}
 }
 

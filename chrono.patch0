+static int sample_record_add(struct rb_root *root, unsigned long addr, char tier){
+	struct numa_sample_record *this;
+	struct rb_node **new = &(root->rb_node), *parent = NULL;
+	struct numa_sample_record *now_record = kzalloc(sizeof(struct numa_sample_record), GFP_KERNEL);
+	now_record->addr = addr;
+	now_record->tier = tier;
+	now_record->latency = 0;
+
+	while(*new){
+		this = rb_entry(*new, struct numa_sample_record, node);
+		parent = *new;
+		if (now_record->addr < this->addr)
+			new = &((*new)->rb_left);
+		else if (now_record->addr > this->addr)
+			new = &((*new)->rb_right);
+		else
+			return 0;
+	}
+
+	/* Add new node and rebalance tree. */
+	rb_link_node(&now_record->node, parent, new);
+	rb_insert_color(&now_record->node, root);
+	//printk("(pid %d): insert %lu",p->pid,now_record->addr);
+	return 1;
+}

+void upload_record(struct task_struct *p, unsigned long latency, char tier)
+{
+	struct sample_block *now_block = p->mm->numa_sample_block;
+	int now_tier;
+	unsigned long bucket,now_hit;
+
+	bucket = jiffies_to_msecs(latency) / 100;
+	bucket = min(bucket,20);
+	WRITE_ONCE(now_block->nr_hit_percent[tier][bucket], READ_ONCE(now_block->nr_hit_percent[tier][bucket]) + 1);
+	for(now_tier = 1;now_tier >= tier;now_tier--){
+		if(now_block->nr_sample[now_tier]){
+				now_hit = READ_ONCE(now_block->nr_hit[now_tier]) + 1;
+				WRITE_ONCE(now_block->nr_hit[now_tier], now_hit);
+				WRITE_ONCE(now_block->avg_time[now_tier], READ_ONCE(now_block->avg_time[now_tier]) + jiffies);
+			}
+		}
+}
+
+int sample_record_find(struct task_struct *p, struct rb_root *root, unsigned long addr)
+{
+	struct rb_node *node = root->rb_node;
+	struct numa_sample_record *now;
+	unsigned long begin_time = p->mm->numa_sample_block->begin_time;
+	while(node){
+		now = container_of(node, struct numa_sample_record, node);
+		if(addr < now->addr)
+			node = node->rb_left;
+		else if (addr > now->addr)
+			node = node->rb_right;
+		else
+			goto find_record;
+	}
+	return 0;
+find_record:
+	if(now->latency == 0){
+		now->latency = jiffies - begin_time;
+		return 1;
+	}else{
+		now->latency = max(now->latency, jiffies - begin_time);;
+		upload_record(p,now->latency,now->tier);
+		return 2;
+	}
+	return -1;
+}
+
+
+void remove_record(struct task_struct *p, struct rb_node *now_node, unsigned long max_latency)
+{
+	struct numa_sample_record *now_record = container_of(now_node, struct numa_sample_record, node);
+	unsigned long latency = now_record->latency;
+	char tier = now_record->tier;
+	if(now_node->rb_left != NULL){
+		remove_record(p, now_node->rb_left, max_latency);
+		now_node->rb_left = NULL;
+	}
+	if(latency == 0){
+		latency = max_latency;
+		upload_record(p, latency, tier);
+	}
+	if(now_node->rb_right != NULL){
+		remove_record(p, now_node->rb_right, max_latency);
+		now_node->rb_right = NULL;
+	}
+	kfree(now_record);
+}
+void clear_records(struct task_struct *p, unsigned long max_latency)
+{
+	struct rb_node *root_node = p->mm->now_rb_root.rb_node;
+	if(root_node != NULL)
+		remove_record(p, root_node, max_latency);
+	p->mm->now_rb_root = RB_ROOT;
+}

+static void mm_init_scanlog(struct mm_struct *mm){
+#ifdef CONFIG_NUMA_BALANCING
+	mm->log_size_n = 64;
+	mm->log_head_n = 0;
+	mm->scan_epoch = 0;
+	mm->scan_results_log = NULL;
+	// void *new_log_buf = krealloc(NULL, sizeof(unsigned long) * 256, GFP_KERNEL);
+	void *new_log_buf = kmalloc(sizeof(unsigned long) * mm->log_size_n * 8, GFP_ATOMIC);
+	if (!new_log_buf){ 
+		printk(KERN_WARNING "Tiering(ERR): The init_scanlog failed.\n");
+		return;
+	}
+	mm->scan_results_log = (unsigned long*)new_log_buf;
+	/* Test to set some of the logs */
+	int i;
+	for (i = 0; i < mm->log_size_n * 8; i = i + 8) {
+		mm->scan_results_log[i] = (((unsigned long)1) << 48) - 1;
+		mm->scan_results_log[i + 1] = (unsigned long)0;
+		mm->scan_results_log[i + 2] = (unsigned long)0;
+		mm->scan_results_log[i + 3] = (unsigned long)0;
+		mm->scan_results_log[i + 4] = (unsigned long)0;
+		mm->scan_results_log[i + 5] = (unsigned long)0;
+		mm->scan_results_log[i + 6] = (unsigned long)0;

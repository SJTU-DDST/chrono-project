diff -Naur tiering/fs/proc/task_mmu.c chrono-project/fs/proc/task_mmu.c
--- tiering/fs/proc/task_mmu.c	2025-05-27 16:57:28.909558035 +0800
+++ chrono-project/fs/proc/task_mmu.c	2025-05-27 16:58:58.331016166 +0800
@@ -19,6 +19,7 @@
 #include <linux/shmem_fs.h>
 #include <linux/uaccess.h>
 #include <linux/pkeys.h>
+#include <linux/sort.h>
 
 #include <asm/elf.h>
 #include <asm/tlb.h>
@@ -344,6 +345,60 @@
 	.show	= show_map
 };
 
+static ssize_t numa_sample_read(struct file *file, char __user *buf, size_t size, loff_t *ppos){
+	ssize_t ret = 0;
+	struct task_struct *p_cur = NULL;
+	struct pglist_data *pgdat;
+	static int readed = 0;
+	int pid_cur,iter;
+	struct sample_block *now_block;
+	size_t sizeto_copy, line_size;
+	unsigned long rest_bytes;
+	int sample_pos;
+	char stat_text[256];
+	if (readed) {
+		readed = 0;
+		return 0;
+	}
+	
+	p_cur = get_proc_task(file_inode(file));
+	if (!p_cur || !p_cur->mm) return 0;
+	while(p_cur->in_sample_block_init);
+	pid_cur = p_cur->pid;
+	now_block = p_cur->mm->numa_sample_block_prev;
+	pgdat = NODE_DATA(0);
+	snprintf(stat_text, 240, "{\"pid\": %d,\"threshold\":%lu,\"calculate_result\": {\"threshold\":%lu,\"rate\":%lu},\"page_number\":[%lu,%lu],\"avg_time\":[%u,%u],\"percent_hit\":[",
+								 pid_cur, pgdat->numa_threshold, p_cur->present_premote_info->threshold, p_cur->present_premote_info->rate, now_block->nr_hit[0], now_block->nr_hit[1],
+								 jiffies_to_msecs(now_block->avg_time[0]),jiffies_to_msecs(now_block->avg_time[1]));
+
+	line_size = strlen(stat_text);
+	sizeto_copy = min(line_size, size);
+	rest_bytes = copy_to_user(buf + ret, stat_text, sizeto_copy);
+	ret += (line_size - rest_bytes);
+
+	for(iter = 0;iter < 20;iter++){
+		snprintf(stat_text, 120, "[%lu,%lu],",
+								now_block->nr_hit_percent[0][iter],now_block->nr_hit_percent[1][iter]);
+		line_size = strlen(stat_text);
+		sizeto_copy = min(line_size, size);
+		rest_bytes = copy_to_user(buf + ret, stat_text, sizeto_copy);
+		ret += (line_size - rest_bytes);
+	}
+
+	snprintf(stat_text, 240, "[%lu,%lu]]}",now_block->nr_hit_percent[0][20], now_block->nr_hit_percent[1][20]);
+	line_size = strlen(stat_text);
+	sizeto_copy = min(line_size, size);
+	rest_bytes = copy_to_user(buf + ret, stat_text, sizeto_copy);
+	ret += (line_size - rest_bytes);
+
+	readed = 1;
+	return ret;
+}
+
+const struct file_operations proc_pid_numa_sample_operations = {
+	.read		= numa_sample_read,
+};
+
 static int pid_maps_open(struct inode *inode, struct file *file)
 {
 	return do_maps_open(inode, file, &proc_pid_maps_op);
@@ -1956,4 +2011,144 @@
 	.release	= proc_map_release,
 };
 
+
+static int scanlog_compare(const void *lhs, const void *rhs) {
+    unsigned long lhs_value = *(const unsigned long *)(lhs + sizeof(unsigned long));
+    unsigned long rhs_value = *(const unsigned long *)(rhs + sizeof(unsigned long));
+
+    if (lhs_value < rhs_value) return -1;
+    if (lhs_value > rhs_value) return 1;
+    return 0;
+}
+
+
+static ssize_t tiering_scanmap_read(struct file *file, char __user *buf, size_t size, loff_t *ppos){
+	ssize_t ret = 0;
+	size_t sizeto_copy;
+	unsigned long rest_bytes;
+
+	static int readed = 0;
+	if (readed) {
+		readed = 0;
+		return 0;
+	}
+
+	char cons_text[] = "This is a header for tiering scanmap\n with a second line.\n";
+	size_t header_size = strlen(cons_text);
+	sizeto_copy = min(header_size, size);
+	rest_bytes = copy_to_user(buf, cons_text, sizeto_copy);
+	ret += (header_size - rest_bytes);
+
+	struct task_struct *p_cur = NULL;
+	p_cur = get_proc_task(file_inode(file));
+	if (!p_cur) return 0;
+
+	int pid_cur = p_cur->pid;
+	char stat_text[128];
+	snprintf(stat_text, 120, "Reading tiering scanmap with pid %d now.\n", pid_cur);
+	size_t line_size = strlen(stat_text);
+	sizeto_copy = min(line_size, size);
+	rest_bytes = copy_to_user(buf + ret, stat_text, sizeto_copy);
+	ret += (line_size - rest_bytes);
+
+	struct mm_struct *mm_cur = p_cur->mm;
+	if (!mm_cur) return 0;
+
+	snprintf(stat_text, 80, "Scanmap size is %d now.\n", mm_cur->log_head_n);
+	line_size = strlen(stat_text);
+	sizeto_copy = min(line_size, size);
+	rest_bytes = copy_to_user(buf + ret, stat_text, sizeto_copy);
+	ret += (line_size - rest_bytes);
+
+	int loop_n = mm_cur->log_head_n;
+	int loop_i = 0;
+	unsigned long *scan_sort = (unsigned long*)kmalloc(sizeof(unsigned long) * loop_n * 2, GFP_ATOMIC);
+
+	for (loop_i = 0; loop_i < loop_n; ++loop_i){
+		snprintf(stat_text, 80, "Scanmap[%d] is (%lx, %lu) now.\n", loop_i, 
+			mm_cur->scan_results_log[loop_i * 8], mm_cur->scan_results_log[loop_i * 8 + 3]);
+		line_size = strlen(stat_text);
+		sizeto_copy = min(line_size, size);
+		rest_bytes = copy_to_user(buf + ret, stat_text, sizeto_copy);
+		ret += (line_size - rest_bytes);
+
+		scan_sort[loop_i * 2] = (unsigned long)loop_i;
+		scan_sort[loop_i * 2 + 1] = READ_ONCE(mm_cur->scan_results_log[loop_i * 8]);
+	}
+
+
+	// may sort the entries
+	sort((void*)scan_sort, loop_n, sizeof(unsigned long) * 2, &scanlog_compare, NULL);
+	for (loop_i = 0; loop_i < loop_n; ++loop_i){
+		int index_cur = (int)(scan_sort[loop_i * 2]);
+		unsigned long log0, log3, log6;
+		log0 = READ_ONCE(mm_cur->scan_results_log[index_cur * 8]);
+		log3 = READ_ONCE(mm_cur->scan_results_log[index_cur * 8 + 3]);
+		log6 = READ_ONCE(mm_cur->scan_results_log[index_cur * 8 + 6]);
+		long inc_counter = (long)log3 - (long)log6;
+		snprintf(stat_text, 32, "(%lx: %ld), ", log0, inc_counter);
+		line_size = strlen(stat_text);
+		sizeto_copy = min(line_size, size);
+		rest_bytes = copy_to_user(buf + ret, stat_text, sizeto_copy);
+		ret += (line_size - rest_bytes);
+		
+	}
+	snprintf(stat_text, 8, "\n");
+	line_size = strlen(stat_text);
+	sizeto_copy = min(line_size, size);
+	rest_bytes = copy_to_user(buf + ret, stat_text, sizeto_copy);
+	ret += (line_size - rest_bytes);
+
+	kvfree(scan_sort);
+	readed = 1;
+	return ret;
+}
+
+const struct file_operations proc_pid_tiering_scanmap_operations = {
+	.read		= tiering_scanmap_read,
+};
+
+static ssize_t tiering_twice_read(struct file *file, char __user *buf, size_t size, loff_t *ppos){
+	ssize_t ret = 0;
+	size_t sizeto_copy;
+	unsigned long rest_bytes;
+
+	static int readed = 0;
+	if (readed) {
+		readed = 0;
+		return 0;
+	}
+
+	struct task_struct *p_cur = NULL;
+	p_cur = get_proc_task(file_inode(file));
+	if (!p_cur) return 0;
+
+	int pid_cur = p_cur->pid;
+	char stat_text[128];
+	snprintf(stat_text, 100, "Reading tiering scanmap with pid %d now.\n", pid_cur);
+	size_t line_size = strlen(stat_text);
+	sizeto_copy = min(line_size, size);
+	rest_bytes = copy_to_user(buf + ret, stat_text, sizeto_copy);
+	ret += (line_size - rest_bytes);
+
+	struct mm_struct *mm_cur = p_cur->mm;
+	if (!mm_cur) return 0;
+
+	unsigned long candi_down = READ_ONCE(mm_cur->hotpage_down);
+	unsigned long candi_up = READ_ONCE(mm_cur->hotpage_up);
+	snprintf(stat_text, 100, "Hotpage candidates down:up is %lu:%lu now.\n", 
+		candi_down, candi_up);
+	line_size = strlen(stat_text);
+	sizeto_copy = min(line_size, size);
+	rest_bytes = copy_to_user(buf + ret, stat_text, sizeto_copy);
+	ret += (line_size - rest_bytes);
+
+	readed = 1;
+	return ret;
+}
+
+const struct file_operations proc_pid_tiering_twice_operations = {
+	.read		= tiering_twice_read,
+};
+
 #endif /* CONFIG_NUMA */

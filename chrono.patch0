+static void mm_free_scanlog(struct mm_struct *mm){
+#ifdef CONFIG_NUMA_BALANCING
+	if (!(mm->scan_results_log)){ 
+		printk(KERN_WARNING "Tiering(ERR): The free_scanlog failed.\n");
+		return;
+	}
+	// krealloc(mm->scan_results_log, 0, GFP_KERNEL);
+	kvfree(mm->scan_results_log);
+#endif
+}
+
+static void mm_free_scanlxa(struct mm_struct *mm){
+#ifdef CONFIG_NUMA_BALANCING
+	if (!(mm->scan_results_xa)){ 
+		printk(KERN_WARNING "Tiering(ERR): Some free_scanlxa failed.\n");
+		return;
+	}
+	xa_destroy(mm->scan_results_xa);
+	kvfree(mm->scan_results_xa);
+#endif
